#Analysis script for CLIF project testing temperature trajectories after CAR-T
#Requires cohort to be loaded from 01_cohort-----------------------------------

cohort <- cohort %>%
  dplyr::mutate(
    cart_group_collapsed = factor(
      dplyr::case_when(
        is.na(cart_group) ~ NA_character_,
        cart_group %in% c(3L, 4L) ~ "BCMA",                # 3=ciltacabtagene, 4=idecabtagene
        cart_group %in% c(1L, 2L, 5L, 6L) ~ "CD19",        # 1=axi-cel, 2=brexu-cel, 5=liso-cel, 6=tisa-cel
        TRUE ~ NA_character_
      ),
      levels = c("CD19", "BCMA")
    )
  )

cohort <- cohort %>%
  dplyr::mutate(
    race_category_collapsed = dplyr::case_when(
      is.na(race_category) ~ NA_character_,
      race_category %in% c("White", "WHITE", "Caucasian") ~ "White",
      race_category %in% c("Black or African American", "BLACK", "African American") ~ "Black",
      TRUE ~ "Other"
    ) %>% 
      factor(levels = c("White", "Black", "Other"))
  )

cohort <- cohort %>%
  dplyr::mutate(
    ethnicity_category_collapsed = dplyr::case_when(
      is.na(ethnicity_category) ~ NA_character_,
      ethnicity_category %in% c("Non-Hispanic", "Not Hispanic or Latino", "Non Hispanic") ~ "Non-Hispanic",
      TRUE ~ "Other"
    ) %>%
      factor(levels = c("Non-Hispanic", "Other"))
  )

cohort <- cohort %>%
  dplyr::mutate(
    easix_fc_cat_collapsed = dplyr::case_when(
      easix_fc_cat %in% c("Low", "Intermediate") ~ "Low",
      easix_fc_cat == "High" ~ "High",
      TRUE ~ NA_character_
    ) %>%
      factor(levels = c("Low", "High")),
    
    easix_f_cat_collapsed = dplyr::case_when(
      easix_f_cat %in% c("Low", "Intermediate") ~ "Low",
      easix_f_cat == "High" ~ "High",
      TRUE ~ NA_character_
    ) %>%
      factor(levels = c("Low", "High"))
  )

cont_var <- c(
  "age_at_admission",
  "index_hospital_LOS",
  "apap_cum_dose_72h",
  "toci_time_until",
  "anakinra_time_until",
  "lymph_abs_infusion",
  "easix", "m_easix", "s_easix",
  "log2_easix", "log2_m_easix", "log2_s_easix",
  "apap_n_doses_72h",
  "toci_n_doses_30d",
  "anakinra_n_doses_30d",
  "steroid_days_30d",
  "abx_30d"   
)

cat_var_all <- c(
  "sex_category",
  "race_category_collapsed",
  "ethnicity_category_collapsed",
  "cart_group_collapsed",
  "death_30d",
  "death_90d",
  "readmit_30d",
  "icu_30d",
  "resp_30d",
  "vaso_30d",
  "easix_f_cat_collapsed",
  "easix_fc_cat_collapsed"
)

cat_var_traj <- c(
  "cart_group_collapsed",
  "death_30d",
  "death_90d",
  "readmit_30d",
  "icu_30d",
  "resp_30d",
  "vaso_30d",
  "easix_f_cat_collapsed",
  "easix_fc_cat_collapsed"
)

bin_vars <- c("death_30d","death_90d","readmit_30d","icu_30d","resp_30d","vaso_30d")


cohort <- cohort %>%
  dplyr::mutate(
    dplyr::across(
      dplyr::all_of(bin_vars),
      ~ dplyr::case_when(
        is.na(.) ~ NA_character_,
        . == 1 ~ "Yes",
        . == 0 ~ "No",
        TRUE ~ as.character(.)
      )
    )
  )

continuous_all <- cohort %>%
  dplyr::select(dplyr::all_of(cont_var)) %>%
  tidyr::pivot_longer(everything(), names_to = "variable", values_to = "value") %>%
  dplyr::summarise(
    n         = sum(!is.na(value)),
    mean      = mean(value, na.rm = TRUE),
    sd        = sd(value, na.rm = TRUE),
    median    = median(value, na.rm = TRUE),
    p25       = quantile(value, 0.25, na.rm = TRUE, type = 2),
    p75       = quantile(value, 0.75, na.rm = TRUE, type = 2),
    min       = suppressWarnings(min(value, na.rm = TRUE)),
    max       = suppressWarnings(max(value, na.rm = TRUE)),
    missing   = sum(is.na(value)),
    .by = "variable"
  )

continuous_by_traj <- cohort %>%
  dplyr::select(trajectory, dplyr::all_of(cont_var)) %>%
  tidyr::pivot_longer(-trajectory, names_to = "variable", values_to = "value") %>%
  dplyr::summarise(
    n         = sum(!is.na(value)),
    mean      = mean(value, na.rm = TRUE),
    sd        = sd(value, na.rm = TRUE),
    median    = median(value, na.rm = TRUE),
    p25       = quantile(value, 0.25, na.rm = TRUE, type = 2),
    p75       = quantile(value, 0.75, na.rm = TRUE, type = 2),
    min       = suppressWarnings(min(value, na.rm = TRUE)),
    max       = suppressWarnings(max(value, na.rm = TRUE)),
    missing   = sum(is.na(value)),
    .by = c("trajectory", "variable")
  ) %>%
  dplyr::arrange(variable, trajectory)

categorical_all <- cohort %>%
  dplyr::select(dplyr::all_of(cat_var_all)) %>%
  dplyr::mutate(dplyr::across(dplyr::all_of(cat_var_all),
      ~forcats::fct_explicit_na(as.factor(.), na_level = "Missing"))) %>%
  tidyr::pivot_longer(dplyr::everything(), names_to  = "variable", values_to = "level"
  ) %>%
  dplyr::count(variable, level, name = "n") %>%
  dplyr::group_by(variable) %>%
  dplyr::mutate(pct = round(100 * n / sum(n), 1)) %>%
  dplyr::ungroup()

categorical_by_traj <- cohort %>%
  dplyr::select(trajectory, dplyr::all_of(cat_var_traj)) %>%
  dplyr::mutate(dplyr::across(dplyr::all_of(cat_var_traj), ~forcats::fct_explicit_na(as.factor(.), na_level = "Missing"))) %>%
  tidyr::pivot_longer(-trajectory, names_to = "variable", values_to = "level") %>%
  dplyr::count(trajectory, variable, level, name = "n") %>%
  dplyr::group_by(trajectory, variable) %>%
  dplyr::mutate(pct = round(100 * n / sum(n), 1)) %>%
  dplyr::ungroup() %>%
  dplyr::arrange(variable, trajectory, level)

cont_var_all_path <- file.path(
  project_location, "proj_output",
  paste0("continuous_summary_", today, ".csv"))

cat_var_all_path <- file.path(
  project_location, "proj_output",
  paste0("categorical_summary_", today, ".csv"))


cont_var_traj_path <- file.path(
  project_location, "proj_output",
  paste0("continuous_by_trajectory_", today, ".csv"))

cat_var_traj_path <- file.path(
  project_location, "proj_output",
  paste0("categorical_by_trajectory_", today, ".csv"))

data.table::fwrite(continuous_all, cont_var_all_path)
data.table::fwrite(categorical_all, cat_var_all_path)
data.table::fwrite(continuous_by_traj, cont_var_traj_path)
data.table::fwrite(categorical_by_traj, cat_var_traj_path)

rm(categorical_all, categorical_by_traj, continuous_all, continuous_by_traj, bin_vars, cat_var_all,
   cat_var, cont_var)
