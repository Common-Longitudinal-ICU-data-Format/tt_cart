## Infection summaries by trajectory =====================================================================

## 72-hour infection summaries by trajectory -----------------------------------

#Overall prevalence of infection at 72 hours by type and source

infections_72h_prevalence =
  df |>
  fgroup_by(trajectory) |>
  fsummarize(
    n_patients   = fnobs(patient_id),
    n_infected   = fsum(infection_72h_01, na.rm = TRUE),
    pct_infected = round(100 * n_infected / n_patients, 1),

    n_bacterial  = fsum(bacterial_72h_01, na.rm = TRUE),
    pct_bacterial = fifelse(n_infected > 0, round(100 * n_bacterial / n_infected, 1), NA_real_),

    n_viral      = fsum(viral_72h_01, na.rm = TRUE),
    pct_viral    = fifelse(n_infected > 0, round(100 * n_viral / n_infected, 1), NA_real_),

    n_fungal     = fsum(fungal_72h_01, na.rm = TRUE),
    pct_fungal   = fifelse(n_infected > 0, round(100 * n_fungal / n_infected, 1), NA_real_),

    n_blood      = fsum(blood_72h_01, na.rm = TRUE),
    pct_blood    = fifelse(n_infected > 0, round(100 * n_blood / n_infected, 1), NA_real_),

    n_urine      = fsum(urine_72h_01, na.rm = TRUE),
    pct_urine    = fifelse(n_infected > 0, round(100 * n_urine / n_infected, 1), NA_real_),

    n_respiratory = fsum(respiratory_72h_01, na.rm = TRUE),
    pct_respiratory = fifelse(n_infected > 0, round(100 * n_respiratory / n_infected, 1), NA_real_),

    n_other_source = fsum(other_source_72h_01, na.rm = TRUE),
    pct_other_source = fifelse(n_infected > 0, round(100 * n_other_source / n_infected, 1), NA_real_)
  ) |>
  fungroup() |>
  roworder(trajectory)

infections_72h_time = 
  df |>
  fgroup_by(trajectory, infection_72h_first_h) |>
  fsummarize(  
    n       = fnobs(infection_72h_first_h),
    sum_x   = fsum(infection_72h_first_h, na.rm = TRUE),
    sum_x_sq = fsum(infection_72h_first_h^2, na.rm = TRUE)
  ) |>
  fungroup()


# Save 72h summaries
save_output(infections_72h_prevalence, "infections_72h_prevalence_by_trajectory", shareable = TRUE, subfolder = "trajectory")
save_output(infections_72h_time, "infections_72h_time_by_trajectory", shareable = TRUE, subfolder = "trajectory")

rm(infections_72h_prevalence, infections_72h_time)
gc()

