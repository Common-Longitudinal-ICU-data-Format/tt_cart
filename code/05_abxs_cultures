  fungroup()

df = join(df, broad_spectrum_72h, on = "patient_id", how = "left", multiple = FALSE)
df = join(df, broad_spectrum_3_30, on = "patient_id", how = "left", multiple = FALSE)

df$broad_spectrum_days_72h  = replace_na(df$broad_spectrum_days_72h, 0L)
