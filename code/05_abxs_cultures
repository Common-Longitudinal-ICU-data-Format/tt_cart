# Exclude normal flora, no growth, parasites, unspecified organisms and negative/indeterminant pcr tests
exclude_organisms = c(
  "no_growth", "pharyngeal_respiratory_flora", "other_organism",
  "amebiasis", "cryptosporidium", "echinoco_ocalcyst", "giardia",
  "protozoal_other", "toxoplasma", "trichomonas")

exclude_results = c("not_detected", "indeterminate")

## Load culture data -----------------------------------------------------------

cultures = 
  data_list$microbiology_culture |>
  dplyr::filter(!is.na(collect_dttm)) |>
  dplyr::filter(!is.na(organism_group)) |>
  dplyr::filter(tolower(organism_group) %!in% exclude_organisms) |>
  dplyr::select(hospitalization_id, organism_id, collect_dttm, fluid_category, organism_group) |>
  dplyr::collect()

cultures = 
  join(cultures, all_hid_crosswalk, on = "hospitalization_id", how = "inner", multiple = TRUE) |>
  fselect(patient_id, collect_dttm, fluid_category, organism_group, organism_id) |>
  funique()

## Load PCR data ---------------------------------------------------------------

pcr = 
  data_list$microbiology_nonculture |>
  dplyr::filter(tolower(method_category) == "pcr") |>
  dplyr::filter(!is.na(collect_dttm)) |>
  dplyr::filter(!is.na(organism_group)) |>
  dplyr::filter(tolower(organism_group) %!in% exclude_organisms) |>
  dplyr::filter(tolower(result_category) %!in% exclude_results) |>
  dplyr::select(hospitalization_id, collect_dttm, fluid_category, organism_group) |>
  dplyr::collect()

pcr = 
  join(pcr, all_hid_crosswalk, on = "hospitalization_id", how = "inner", multiple = TRUE) |>
  fselect(patient_id, collect_dttm, fluid_category, organism_group) |>
  fmutate(organism_id = NA_character_) |> 
  funique()


## Combine cultures and PCR ----------------------------------------------------

infections_all = 
  rbind(cultures, pcr) |>
  join(anchor_df, on = "patient_id", how = "inner", multiple = TRUE) |>
  fmutate(
    h_since_cart = as.numeric(difftime(collect_dttm, cart_t0, units = "hours")),
    d_since_cart = as.integer(floor(h_since_cart / 24)),
    
    # Classify organism type
    organism_type = case_when(
      tolower(organism_group) %in% bacterial_organisms ~ "bacterial",
      tolower(organism_group) %in% viral_organisms     ~ "viral",
      tolower(organism_group) %in% fungal_organisms    ~ "fungal",
      TRUE                                             ~ "other"
    ),
    
    # Classify infection source
    infection_source = case_when(
      tolower(fluid_category) == "blood_buffy" ~ "blood",
      tolower(fluid_category) %in% c("genito_urinary_tract", "kidneys_renal_pelvis_ureters_bladder") ~ "urine",
      tolower(fluid_category) %in% c("respiratory_tract", "respiratory_tract_lower", 
                                      "nasopharynx_upperairway", "oropharynx_tongue_oralcavity") ~ "respiratory",
      tolower(fluid_category) %in% c("feces_stool", "gastrointestinal_tract", "stomach", 
                                      "small_intestine", "large_intestine") ~ "other",
      tolower(fluid_category) %in% c("central_nervous_system", "brain", "meninges_csf", "spinal_cord") ~ "other",
      tolower(fluid_category) %in% c("woundsite", "skin_unspecified", "skin_rash_pustules_abscesses",
                                      "skin_disseminated_multiple_sites") ~ "other",
      TRUE ~ "other"
    )
  ) |>
  fsubset(organism_type != "other")

rm(cultures, pcr)
gc()

