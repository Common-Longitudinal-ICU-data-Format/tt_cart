# ==============================================================================
# 09_treatment_assignment.R
# Treatment assignment analysis: What predicts CAR-T infusion timing?
# Required step before target trial emulation
# Requires: df from 06_export.R with day_of_week computed
# ==============================================================================

if (!exists("df") || !exists("save_output")) {
  stop("Run 00_setup.R through 06_export.R first.", call. = FALSE)
}

message("Starting 09_treatment_assignment.R")

# packages =====================================================================

if (!requireNamespace("broom", quietly = TRUE)) install.packages("broom")
library(broom)

# ensure required variables exist ==============================================

required_vars = c("cart_hour_precise", "age", "sex_category", "race_eth", 
                  "cart_target", "vw", "easix_fc_cat", "infusion_year",
                  "day_of_week_f")

missing = setdiff(required_vars, names(df))
if (length(missing) > 0) {
  stop("Missing variables: ", paste(missing, collapse = ", "), 
       "\nEnsure day_of_week_f is computed in 06_export.R")
}


# early/late binary outcome ====================================================

CUTOFF = 15  # 3 PM
df$early_01 = as.integer(df$cart_hour_precise < CUTOFF)

message("\n== Sample ==")
message("  Total N: ", fnrow(df))
message("  Early (<", CUTOFF, ":00): ", fsum(df$early_01 == 1, na.rm = TRUE), 
        " (", round(100 * fmean(df$early_01, na.rm = TRUE), 1), "%)")
message("  Late (>=", CUTOFF, ":00): ", fsum(df$early_01 == 0, na.rm = TRUE))

# ==============================================================================
# MODEL 1: LOGISTIC — What predicts early vs late?
# ==============================================================================

message("\n== Model 1: Logistic (early vs late) ==")

## 1a. Core clinical + temporal predictors -------------------------------------

logistic_core = tryCatch({
  glm(early_01 ~ age + sex_f + race_eth_f + cart_target_f + vw + 
        easix_fc_f + year_f + day_of_week_f,
      data = df, family = binomial)
}, error = function(e) { message("  Core model failed: ", e$message); NULL })

if (!is.null(logistic_core)) {
  coefs_core = tidy(logistic_core, exponentiate = TRUE, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "core", site = site_lowercase)
  
  message("  Core model AIC: ", round(AIC(logistic_core), 1))
  message("  Pseudo-R²: ", round(1 - logistic_core$deviance / logistic_core$null.deviance, 4))
}

## 1b. Extended model (add baseline labs, steroids, infection) -----------------

# Build formula dynamically based on available variables
extended_terms = c("age", "sex_f", "race_eth_f", "cart_target_f", "vw",
                   "easix_fc_f", "year_f", "day_of_week_f")

# Add optional terms if they exist
optional_terms = c("hct_01", "baseline_steroid", "baseline_crp", 
                   "baseline_ferritin", "baseline_ldh",
                   "infection_base_01", "baseline_antibacterial_01",
                   "cancer_cat", "season_f")

for (term in optional_terms) {
  if (term %in% names(df) && sum(!is.na(df[[term]])) > 30) {
    extended_terms = c(extended_terms, term)
  }
}

formula_extended = as.formula(paste("early_01 ~", paste(extended_terms, collapse = " + ")))

logistic_extended = tryCatch({
  glm(formula_extended, data = df, family = binomial)
}, error = function(e) { message("  Extended model failed: ", e$message); NULL })

if (!is.null(logistic_extended)) {
  coefs_extended = tidy(logistic_extended, exponentiate = TRUE, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "extended", site = site_lowercase)
  
  message("  Extended model AIC: ", round(AIC(logistic_extended), 1))
  message("  Pseudo-R²: ", round(1 - logistic_extended$deviance / logistic_extended$null.deviance, 4))
}

# ==============================================================================
# MODEL 2: LINEAR — What predicts continuous infusion hour?
# ==============================================================================

message("\n== Model 2: Linear (continuous hour) ==")

## 2a. Core model --------------------------------------------------------------

linear_core = tryCatch({
  lm(cart_hour_precise ~ age + sex_f + race_eth_f + cart_target_f + vw + 
       easix_fc_f + year_f + day_of_week_f,
     data = df)
}, error = function(e) { message("  Core linear model failed: ", e$message); NULL })

if (!is.null(linear_core)) {
  coefs_linear_core = tidy(linear_core, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "core_linear", site = site_lowercase)
  
  r2 = summary(linear_core)$r.squared
  adj_r2 = summary(linear_core)$adj.r.squared
  message("  R²: ", round(r2, 4), " | Adj R²: ", round(adj_r2, 4))
}

## 2b. Extended model ----------------------------------------------------------

formula_linear_ext = as.formula(paste("cart_hour_precise ~", paste(extended_terms, collapse = " + ")))

linear_extended = tryCatch({
  lm(formula_linear_ext, data = df)
}, error = function(e) { message("  Extended linear model failed: ", e$message); NULL })

if (!is.null(linear_extended)) {
  coefs_linear_ext = tidy(linear_extended, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "extended_linear", site = site_lowercase)
  
  r2 = summary(linear_extended)$r.squared
  adj_r2 = summary(linear_extended)$adj.r.squared
  message("  R²: ", round(r2, 4), " | Adj R²: ", round(adj_r2, 4))
}

# ==============================================================================
# COMBINE AND EXPORT
# ==============================================================================

message("\n== Exporting ==")

# Combine all coefficient tables
all_coefs = list()
if (exists("coefs_core"))       all_coefs = c(all_coefs, list(coefs_core))
if (exists("coefs_extended"))   all_coefs = c(all_coefs, list(coefs_extended))
if (exists("coefs_linear_core")) all_coefs = c(all_coefs, list(coefs_linear_core))
if (exists("coefs_linear_ext")) all_coefs = c(all_coefs, list(coefs_linear_ext))

if (length(all_coefs) > 0) {
  assignment_coefs = rbindlist(all_coefs, fill = TRUE)
  save_output(assignment_coefs, "treatment_assignment_coefs", 
              shareable = TRUE, subfolder = "circadian")
  message("  Saved coefficient table")
}

# ==============================================================================
# DESCRIPTIVE SUMMARIES
# ==============================================================================

message("\n== Descriptive summaries ==")

## Hour distribution by day of week --------------------------------------------

hour_by_dow = 
  fgroup_by(df, day_of_week_f) |>
  fsummarize(
    n          = fnobs(cart_hour_precise),
    hour_sum   = fsum(cart_hour_precise, na.rm = TRUE),
    hour_sum_sq = fsum(cart_hour_precise^2, na.rm = TRUE),
    n_early    = fsum(early_01, na.rm = TRUE),
    pct_early  = round(100 * fmean(early_01, na.rm = TRUE), 1)
  ) |>
  fungroup()

save_output(hour_by_dow, "hour_by_day_of_week", shareable = TRUE, subfolder = "circadian")

## Hour distribution by year ---------------------------------------------------

hour_by_year = 
  fgroup_by(df, infusion_year) |>
  fsummarize(
    n          = fnobs(cart_hour_precise),
    hour_sum   = fsum(cart_hour_precise, na.rm = TRUE),
    hour_sum_sq = fsum(cart_hour_precise^2, na.rm = TRUE),
    n_early    = fsum(early_01, na.rm = TRUE),
    pct_early  = round(100 * fmean(early_01, na.rm = TRUE), 1)
  ) |>
  fungroup()

save_output(hour_by_year, "hour_by_year", shareable = TRUE, subfolder = "circadian")

## Hour distribution by CAR-T product ------------------------------------------

hour_by_product = 
  fgroup_by(df, cart_name) |>
  fsummarize(
    n          = fnobs(cart_hour_precise),
    hour_sum   = fsum(cart_hour_precise, na.rm = TRUE),
    hour_sum_sq = fsum(cart_hour_precise^2, na.rm = TRUE),
    n_early    = fsum(early_01, na.rm = TRUE),
    pct_early  = round(100 * fmean(early_01, na.rm = TRUE), 1)
  ) |>
  fungroup()

save_output(hour_by_product, "hour_by_product", shareable = TRUE, subfolder = "circadian")

## Hour distribution by CAR-T target -------------------------------------------

hour_by_target = 
  fgroup_by(df, cart_target) |>
  fsummarize(
    n          = fnobs(cart_hour_precise),
    hour_sum   = fsum(cart_hour_precise, na.rm = TRUE),
    hour_sum_sq = fsum(cart_hour_precise^2, na.rm = TRUE),
    n_early    = fsum(early_01, na.rm = TRUE),
    pct_early  = round(100 * fmean(early_01, na.rm = TRUE), 1)
  ) |>
  fungroup()

save_output(hour_by_target, "hour_by_target", shareable = TRUE, subfolder = "circadian")

# ==============================================================================
# INTERPRETATION GUIDE
# ==============================================================================

message("\n== Interpretation Guide ==")

if (!is.null(logistic_extended)) {
  
  # Identify significant predictors (p < 0.05)
  sig_terms = coefs_extended[p.value < 0.05 & term != "(Intercept)"]
  
  if (nrow(sig_terms) > 0) {
    message("\n  SIGNIFICANT predictors of early infusion (p < 0.05):")
    for (i in seq_len(nrow(sig_terms))) {
      direction = ifelse(sig_terms$estimate[i] > 1, "MORE likely early", "LESS likely early")
      message(sprintf("    %s: OR=%.2f (%.2f-%.2f), p=%.4f → %s",
                      sig_terms$term[i], sig_terms$estimate[i],
                      sig_terms$conf.low[i], sig_terms$conf.high[i],
                      sig_terms$p.value[i], direction))
    }
    message("\n  ⚠ These variables MUST be adjusted for in the target trial emulation.")
  } else {
    message("\n  ✓ No significant predictors of infusion timing found.")
    message("    This suggests timing is quasi-random — strengthens causal inference.")
  }
  
  pseudo_r2 = 1 - logistic_extended$deviance / logistic_extended$null.deviance
  if (pseudo_r2 < 0.05) {
    message("\n  ✓ Pseudo-R² = ", round(pseudo_r2, 4), " (very low)")
    message("    Very little variance in timing is explained by measured covariates.")
    message("    Consistent with quasi-random treatment assignment.")
  } else if (pseudo_r2 < 0.15) {
    message("\n  ⚠ Pseudo-R² = ", round(pseudo_r2, 4), " (moderate)")
    message("    Some systematic factors influence timing.")
    message("    Propensity score adjustment is recommended.")
  } else {
    message("\n  ⚠ Pseudo-R² = ", round(pseudo_r2, 4), " (substantial)")
    message("    Timing is substantially non-random.")
    message("    Strong propensity score adjustment or IPW is essential.")
  }
}

if (!is.null(linear_extended)) {
  r2 = summary(linear_extended)$r.squared
  message("\n  Linear model R² = ", round(r2, 4))
  
  # ANOVA to see which terms explain most variance
  message("\n  Variance decomposition (Type I ANOVA):")
  aov_table = tryCatch({
    anova(linear_extended)
  }, error = function(e) NULL)
  
  if (!is.null(aov_table)) {
    aov_dt = as.data.table(aov_table, keep.rownames = "term")
    aov_dt$pct_ss = round(100 * aov_dt$`Sum Sq` / sum(aov_dt$`Sum Sq`), 2)
    top_terms = aov_dt[order(-pct_ss)][1:min(5, nrow(aov_dt))]
    for (i in seq_len(nrow(top_terms))) {
      message(sprintf("    %s: %.1f%% of variance, p=%.4f",
                      top_terms$term[i], top_terms$pct_ss[i],
                      top_terms$`Pr(>F)`[i]))
    }
  }
}

# ==============================================================================
# CLEAN UP
# ==============================================================================

rm(list = ls(pattern = "^(logistic_|linear_|coefs_|sig_|formula_|extended_terms|optional_terms)"))
gc()

message("\n09_treatment_assignment.R complete.")
