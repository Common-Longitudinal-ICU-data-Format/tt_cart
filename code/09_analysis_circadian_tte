# ==============================================================================
# 09_treatment_assignment.R
# Treatment assignment analysis: What predicts CAR-T infusion timing?
# Requires: df from 06_export.R
# ==============================================================================

if (!exists("df") || !exists("save_output")) {
  stop("Run 00_setup.R through 06_export.R first.", call. = FALSE)
}

message("Starting 09_treatment_assignment.R")

# ==============================================================================
# MODEL 1: LOGISTIC — What predicts early vs late?
# ==============================================================================

message("\n== Model 1: Logistic (early vs late) ==")

df$early_01 = as.integer(df$early_late == "early")

logistic_core = tryCatch({
  glm(early_01 ~ age + sex_f + race_eth_f + cart_target_f + vw + 
        log2_m_easix + cancer_cat + year_f + hct_01,
      data = df, family = binomial)
}, error = function(e) { message("  Core model failed: ", e$message); NULL })

if (!is.null(logistic_core)) {
  coefs_core = tidy(logistic_core, exponentiate = TRUE, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "core", site = site_lowercase)
  
  message("  Core model AIC: ", round(AIC(logistic_core), 1))
  message("  Pseudo-R²: ", round(1 - logistic_core$deviance / logistic_core$null.deviance, 4))
}

# ==============================================================================
# MODEL 2: LINEAR — Do patient factors predict continuous infusion hour?
# ==============================================================================

message("\n== Model 2: Linear (continuous hour) ==")

linear_core = tryCatch({
  lm(cart_hour_precise ~ age + sex_f + race_eth_f + cart_target_f + vw +
       log2_m_easix + hct_01 + cancer_cat + year_f,
     data = df)
}, error = function(e) { message("  Core linear model failed: ", e$message); NULL })

if (!is.null(linear_core)) {
  coefs_linear_core = tidy(linear_core, conf.int = TRUE) |>
    as.data.table() |>
    fmutate(model = "core_linear", site = site_lowercase)
  
  r2 = summary(linear_core)$r.squared
  adj_r2 = summary(linear_core)$adj.r.squared
  message("  R²: ", round(r2, 4), " | Adj R²: ", round(adj_r2, 4))
}

# ==============================================================================
# COMBINE AND EXPORT
# ==============================================================================

message("\n== Exporting ==")

all_coefs = list()
if (exists("coefs_core"))        all_coefs = c(all_coefs, list(coefs_core))
if (exists("coefs_linear_core")) all_coefs = c(all_coefs, list(coefs_linear_core))

if (length(all_coefs) > 0) {
  assignment_coefs = rbindlist(all_coefs, fill = TRUE)
  save_output(assignment_coefs, "treatment_assignment_coefs",
              shareable = TRUE, subfolder = "circadian")
  message("  Saved coefficient table")
}
